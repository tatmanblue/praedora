# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Sqlite | Postgres | SqlServer — only Sqlite is implemented so far (build sequence step 6
# adds Postgres/SQL Server as a config-only swap).
PRAEDORA_DB_PROVIDER=Sqlite
PRAEDORA_DB_CONNECTION=Data Source=praedora.db

# Gmail OAuth client (Google Cloud Console) — used by GmailEmailProvider, build sequence step 4.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Anthropic API key — used by ClaudeClassifier / ClaudeJobDescriptionExtractor.
CLAUDE_API_KEY=

PRAEDORA_LISTEN_PORT=5080
