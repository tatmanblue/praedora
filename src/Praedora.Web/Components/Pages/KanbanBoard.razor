@page "/"

<PageTitle>Praedora — Board</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">Board</h1>
    <button class="btn btn-primary btn-sm" @onclick="ToggleCaptureForm">+ New Application</button>
</div>

@if (showCaptureForm)
{
    <div class="card mb-3">
        <div class="card-body">
            <EditForm Model="captureForm" OnValidSubmit="SubmitCaptureAsync">
                <DataAnnotationsValidator />
                <div class="row g-2">
                    <div class="col-md-4">
                        <InputText class="form-control" placeholder="Company" @bind-Value="captureForm.CompanyName" />
                    </div>
                    <div class="col-md-4">
                        <InputText class="form-control" placeholder="Role title" @bind-Value="captureForm.RoleTitle" />
                    </div>
                    <div class="col-md-4">
                        <InputText class="form-control" placeholder="Source URL (optional)" @bind-Value="captureForm.SourceUrl" />
                    </div>
                    <div class="col-12">
                        <InputTextArea class="form-control" rows="4" placeholder="Job description"
                                       @bind-Value="captureForm.JobDescriptionRaw" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary btn-sm" disabled="@isSubmitting">Capture</button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ToggleCaptureForm">Cancel</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (isLoading)
{
    <p class="text-body-secondary">Loading…</p>
}
else
{
    <div class="d-flex gap-2 overflow-auto pb-3">
        @foreach (ApplicationStatus status in Enum.GetValues<ApplicationStatus>())
        {
            <div class="flex-shrink-0" style="width: 260px;">
                <h2 class="h6 text-body-secondary">@status (@ColumnCount(status))</h2>
                @foreach (ApplicationSummaryDto application in ApplicationsFor(status))
                {
                    <ApplicationCard Application="application"
                                      StatusChanged="newStatus => OnCardStatusChangedAsync(application.Id, newStatus)" />
                }
            </div>
        }
    </div>
}
