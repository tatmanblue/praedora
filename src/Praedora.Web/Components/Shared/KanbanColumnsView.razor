<div class="d-flex gap-2 overflow-auto pb-3">
    @foreach (ApplicationStatus status in Enum.GetValues<ApplicationStatus>())
    {
        <div class="flex-shrink-0" style="width: 260px;">
            <h2 class="h6 text-body-secondary">@status (@CountFor(status))</h2>
            @foreach (ApplicationSummaryDto application in ApplicationsFor(status))
            {
                <ApplicationCard Application="application"
                                  StatusChanged="newStatus => OnStatusChanged.InvokeAsync((application.Id, newStatus))" />
            }
        </div>
    }
</div>
